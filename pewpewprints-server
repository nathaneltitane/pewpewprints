#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (($#))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

local_content_directory="${PWD}"/
local_server_directory=/var/www/html/pewpewprints/

# defaults ─────────────────────────────────────────────────────────────────────

list=(
	apache2
)

frobulator.require ${list[@]}

# functions ────────────────────────────────────────────────────────────────────

# generate server configuration

cat <<- 'FILE' > /etc/apache2/sites-enabled/pewpewprints.conf
<VirtualHost *: 80>
        ServerAdmin     nathanel.titane@gmail.com
        ServerName      pewpewprints
        ServerAlias     dev.pewpewprints.com
        DocumentRoot    /var/www/html/pewpewprints/
        ErrorLog        ${APACHE_LOG_DIR}/pewpewprints.error.log
        CustomLog       ${APACHE_LOG_DIR}/pewpewprints.access.log combined
</VirtualHost>
FILE

# reload service

service apache2 reload

# enable virtual host configuration distribution

a2ensite pewpewprints.conf

# configure server host address

cat <<- 'FILE' >> /etc/hosts
127.0.0.1       dev.pewpewprints.com
FILE

# generate local server directory

directories_list=(
	/var/www/html/pewpewprints
)

for directory in ${directories_list[@]}
do
	mkdir -p "${directory}"

	chmod -R 777 "${directory}"
done

# pull ─────────────────────────────────────────────────────────────────────────

rsync							\
	--archive					\
	--quiet						\
	--recursive					\
	--exclude='*.sldasm'		\
	--exclude='*.sldprt'		\
	--exclude='*.stl'			\
								"${local_content_directory}"/* "${local_server_directory}"

frobulator.cpt "Complete" "[ Server ]"
