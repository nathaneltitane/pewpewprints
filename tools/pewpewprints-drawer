#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

# load frobulator once

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# keep the sudo user home

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	# local copy and download

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# fetch the latest release

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	# keep only a newer release

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	# drop the download

	rm -f "${frobulator_download}"

	# stop without frobulator

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	# load the library

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

# models and output folders

directory_models="${PWD}"/models
directory_modules="${PWD}"/modules

# version stamp

date_version=$(date +"%m-%d-%Y")

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

# report progress

frobulator.inf "Generating model entries"

frobulator.fwd "Writing..."

# page header

cat << 'MODEL-DRAWER-HEADER' -> "modules/drawer.html"

			<!-- scripts -->

			<script src="/javascript/year.js" type="text/javascript"></script>

			<script type="text/javascript">

			$(function() {

				$.get("/modules/notice.html", function(data) {

					$("#notice").append(data);

				});

			});

			</script>

			<!-- notice -->

			<div id="notice">

			</div>

			<!-- models start -->

			<div class="grid">

MODEL-DRAWER-HEADER

# model entries

# file types

list_extensions=(
	png
)

for extension in ${list_extensions[@]}
do
	count_entries=0

	# every model render

	list_renders=( $(find "${directory_models}" -type f -iname "render.${extension}" | sort) )

	# split on new lines

	IFS=$'\n'

	for path_render in ${list_renders[@]}
	do
		# path below the site root

		path_render=$(echo "${path_render}" | cut -d '/' -f6-)

		# render file name

		file_render="${path_render##*/}"

		# name without extension

		name_render="${file_render%.*}"

		# model folder

		directory_model="${path_render%/*/*}"

		# model details

		content_compatibility=$(cat "${directory_model}"/compatibility)

		text_compatibility=$(echo ${content_compatibility})

		content_category=$(cat "${directory_model%/*}"/title)

		text_category=$(echo ${content_category})

		content_name=$(cat "${directory_model}"/model)

		text_name=$(echo ${content_name//\<\/\br\>/})

		# hidden product name

		name_folder_model="${directory_model##*/}"

		content_title=$(cat "${directory_model}"/title)

		text_title=$(echo ${content_title//\<\/\br\>/})

		content_dart=$(cat "${directory_model}"/dart)

		text_dart=$(echo ${content_dart//\<\/\br\>/})

		content_type=$(cat "${directory_model}"/type)

		text_type=$(echo ${content_type//\<\/\br\>/})

		content_attachment=$(cat "${directory_model}"/attachment)

		text_attachment=$(echo ${content_attachment})

		content_weight=$(cat "${directory_model}"/weight)

		text_weight=$(echo ${content_weight})

		file_paypal="${directory_model}"/paypal

		id_paypal=$(cat "${directory_model}"/paypal)

		file_price="${directory_model}"/price

		price_model=$(cat "${directory_model}"/price)

		file_quote="${directory_model}"/quote

		price_print=$(cat "${directory_model}"/quote)

# drawer entry

cat << MODEL-CONTENT ->> "modules/drawer.html"
