						</div>

						<div class="grid-3 text-right">

							${text_compatibility}

						</div>

						<div class="grid-4 section">

							<hr>

						</div>

						<div class="grid-1">

							MODEL

						</div>

						<div class="grid-3 text-right">

							${text_name}

						</div>

						<div class="grid-4 section">

							<hr>

						</div>

						<div class="grid-1">

							TITLE

						</div>

						<div class="grid-3 text-right">

							${text_title}

						</div>

						<div class="grid-1">

							DART

						</div>

						<div class="grid-3 text-right">

							${text_dart}

						</div>

						<div class="grid-1">

							TYPE

						</div>

						<div class="grid-3 text-right">

							${text_type}

						</div>

						<div class="grid-4 section">

							<hr>

						</div>

						<div class="grid-1">

							ATTACHMENT

						</div>

						<div class="grid-3 text-right">

							${text_attachment}

						</div>

						<div class="grid-4 section">

							<hr>

						</div>

						<div class="grid-1">

							WEIGHT

						</div>

						<div class="grid-3 text-right">

							${text_weight} G

						</div>

						<div class="hide product-name grid-4 text-right">

							${name_folder_model}

						</div>

					</div>

				</div>

MODEL-CONTENT

	# count the entry

	(( count_entries ++ ))

	done

# copyright card

cat << COPYRIGHT ->> "modules/drawer.html"
				<!-- copyright -->

				<div class="container copyright text-center">

					<div class="grid">

						<div class="grid-4 text-right">

							COPYRIGHT

						</div>

						<div class="grid-4">

